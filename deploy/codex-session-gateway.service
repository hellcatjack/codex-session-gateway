[Unit]
Description=Codex Session Gateway
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=hellcat
Group=hellcat
WorkingDirectory=/app/codexTelegramShell

# Defaults (can be overridden by EnvironmentFile).
Environment=LOG_LEVEL=INFO
Environment=PYTHONUNBUFFERED=1
Environment=PATH=/home/hellcat/.nvm/versions/node/v22.21.1/bin:/usr/local/bin:/usr/bin:/bin
Environment=XDG_RUNTIME_DIR=/run/user/%U
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/%U/bus
EnvironmentFile=/app/codexTelegramShell/.env
ExecStart=/app/codexTelegramShell/.venv/bin/python -m src.main
Restart=always
RestartSec=5

# Be explicit: log to journald (which handles rotation/retention).
StandardOutput=journal
StandardError=journal

# Backstop in case something starts spamming logs.
LogRateLimitIntervalSec=30s
LogRateLimitBurst=2000

[Install]
WantedBy=multi-user.target
